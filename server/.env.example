# Your Claude API key from https://platform.claude.com (keep it secret, never put it in the app)
ANTHROPIC_API_KEY=sk-ant-...

# A password the phone app sends with every request, so strangers can't use your key.
# Make up any long random string and enter the same value in the app's Settings.
HANASHI_APP_TOKEN=change-me-to-something-long

# Optional
# HANASHI_MODEL=claude-opus-5-5
# HANASHI_EFFORT=low
